{
  "name": "VibeStation Cloud - Pure Gigabit Linux Desktop RDP for iPad",
  "dockerFile": "Dockerfile",
  "forwardPorts": [6080, 3000],
  "portsAttributes": {
    "6080": {
      "label": "Linux Desktop GUI (noVNC Gigabit RDP)",
      "onAutoForward": "openBrowser"
    },
    "3000": {
      "label": "VibeStation Control Center",
      "onAutoForward": "silent"
    }
  },
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.gpuAcceleration": "on",
        "terminal.integrated.fontSize": 14,
        "terminal.integrated.lineHeight": 1.25,
        "editor.fontSize": 15,
        "editor.lineHeight": 22,
        "editor.fontFamily": "'Fira Code', Menlo, Monaco, 'Courier New', monospace",
        "editor.fontLigatures": true,
        "editor.minimap.enabled": false,
        "editor.cursorBlinking": "smooth",
        "editor.smoothScrolling": true,
        "workbench.activityBar.location": "top",
        "workbench.colorTheme": "Default Dark Modern",
        "files.autoSave": "afterDelay",
        "files.autoSaveDelay": 1000
      },
      "extensions": [
        "ms-python.python",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "eamodio.gitlens"
      ]
    }
  },
  "postCreateCommand": "bash .devcontainer/setup-env.sh"
}
